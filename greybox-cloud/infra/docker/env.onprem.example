PORT=8080
GREYBOX_DEPLOYMENT_MODE=on-prem

# Mounted by compose.onprem.yaml from ./licenses.
GREYBOX_OFFLINE_LICENSE_FILE=/licenses/license.greybox.json
GREYBOX_OFFLINE_LICENSE_PUBLIC_KEY_FILE=/licenses/greybox-license-public.pem

# Rotate per enterprise tenant before handoff.
GREYBOX_BILLING_ADMIN_TOKEN=replace-with-long-random-token
