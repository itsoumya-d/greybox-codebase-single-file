# greybox-cloud environment configuration template.
# Copy to .env (or set in your hosting platform) and fill in the values.
# Never commit a populated .env file. The repository .gitignore should already exclude it.

# ----- Runtime -----------------------------------------------------------
NODE_ENV=production
PORT=8080
GREYBOX_CLOUD_VERSION=0.1.0-alpha.1

# ----- HTTP security ----------------------------------------------------
# Comma-separated list of allowed origins for CORS. Use exact origins
# (https://app.greybox.studio), not wildcards in production.
GREYBOX_CLOUD_ALLOWED_ORIGINS=https://app.greybox.studio,https://greybox.studio

# Per-IP rate limit (sliding window). Defaults are conservative; raise for
# multi-tenant pools, lower for low-trust public endpoints.
GREYBOX_CLOUD_HTTP_RATE_LIMIT_BURST=120
GREYBOX_CLOUD_HTTP_RATE_LIMIT_PER_SECOND=10

# Max JSON payload size (bytes). 1 MB is enough for license + billing calls.
GREYBOX_CLOUD_MAX_PAYLOAD_BYTES=1048576

# ----- License validation -----------------------------------------------
# JSON array of LicenseRecord objects (see src/routers/licenses.ts).
# Required in production unless GREYBOX_LICENSE_SIGNING_KEYS_JSON is set.
# GREYBOX_LICENSE_RECORDS_JSON=

# Ed25519 signing-key registry for signed license tokens.
# JSON array of { keyId, publicKeyPem } records.
# GREYBOX_LICENSE_SIGNING_KEYS_JSON=

# DANGEROUS: set to 1 only if you knowingly want to accept legacy
# prefix-matching license tokens (e.g. gbx_pro_*) in production. Default
# behavior is to refuse them.
# GREYBOX_CLOUD_ALLOW_PREFIX_FALLBACK=0

# ----- Stripe (billing + metering) --------------------------------------
STRIPE_API_KEY=
# Set to 'true' to enable live Stripe meter event submission.
# Requires STRIPE_API_KEY to be a live key (sk_live_*). Defaults to dry-run mode.
GREYBOX_STRIPE_METERING_ENABLED=false
STRIPE_WEBHOOK_SECRET=

# Stripe metering price IDs (configure these in Stripe dashboard first).
GREYBOX_STRIPE_PRICE_INFERENCE_TOKENS=

# Stripe subscription price IDs powering POST /v1/billing/checkout-session.
# Configure the recurring subscription prices in the Stripe dashboard and
# paste the price_ ids here. If unset, /v1/billing/checkout-session returns
# 503 stripe_price_not_configured and /v1/billing/checkout renders disabled.
STRIPE_PRICE_INDIE=
STRIPE_PRICE_STUDIO=
GREYBOX_BILLING_CHECKOUT_SUCCESS_URL=https://app.greybox.studio/billing/success?session_id={CHECKOUT_SESSION_ID}
GREYBOX_BILLING_CHECKOUT_CANCEL_URL=https://app.greybox.studio/billing/cancel

# Per-tenant rate limit for /v1/billing/checkout-session,
# /v1/billing/hosted-checkout, and /v1/billing/portal-session.
# Defaults: 10 burst, 0.1667 req/s (= 10/min).
# Lower these to throttle abuse; raise them only after monitoring Stripe API
# spend.
GREYBOX_BILLING_RATE_LIMIT_BURST=10
GREYBOX_BILLING_RATE_LIMIT_PER_SECOND=0.1667

# Durable billing ledger for managed-inference usage, invoices, and Stripe
# meter-event attempts.
GREYBOX_BILLING_LEDGER_DIR=/data/billing-ledger
# Use Postgres instead of the file store for hosted multi-replica metering.
# GREYBOX_BILLING_LEDGER_PG_URL=postgres://greybox:****@db.internal:5432/greybox
# Optional: override the default `billing_ledger` table name.
# GREYBOX_BILLING_LEDGER_PG_TABLE=billing_ledger

# ----- Razorpay (India-compatible subscription billing) -----------------
# Required for Indian tenants using Razorpay subscriptions.
# Create plans in the Razorpay dashboard and paste the plan_ ids here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_INDIE=
RAZORPAY_PLAN_STUDIO=

# ----- Dodo Payments (Merchant of Record, international) ----------------
# Dodo handles all global tax/VAT as the Merchant of Record.
# Create products in the Dodo dashboard and paste the product ids here.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_INDIE=
DODO_PRODUCT_STUDIO=

# ----- Admin tokens -----------------------------------------------------
# Rotate quarterly. Document the rotation in OPERATIONS.md.
GREYBOX_BILLING_ADMIN_TOKEN=
GREYBOX_CLOUD_ADMIN_TOKEN=

# ----- WorkOS (SSO + SCIM) ----------------------------------------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
GREYBOX_WORKOS_GROUP_ROLE_MAP=

# ----- Inference providers ---------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----- Observability ---------------------------------------------------
# Optional. When unset, telemetry runs as no-op (see src/observability/sentry.ts).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ----- PII redaction evidence ------------------------------------------
# Customer-safe source-hash evidence for /v1/enterprise/pii-redaction-evidence.
# Generate with: pnpm --silent pii:evidence --format=dotenv
# GREYBOX_PII_REDACTION_EVIDENCE_JSON=
# Or mount the generated dotenv/json evidence as a secret file.
# GREYBOX_PII_REDACTION_EVIDENCE_FILE=/run/secrets/pii-redaction-evidence.env

# ----- Pro module secret signing ---------------------------------------
GREYBOX_PRO_MODULE_SECRET_MASTER_KEY=
GREYBOX_PRO_MODULE_BUNDLES_JSON=
GREYBOX_PRO_MODULE_BUNDLE_UPLOAD_PLAN_JSON=
GREYBOX_PRO_MODULE_BUNDLE_PUBLISH_PROOF_JSON=

# ----- Marketplace integration -----------------------------------------
GREYBOX_MARKETPLACE_URL=https://marketplace.greybox.studio
GREYBOX_MARKETPLACE_ADMIN_TOKEN=

# ----- Data residency --------------------------------------------------
# Default tenant data-residency label. Provider constraints are configured
# through GREYBOX_PROVIDER_POLICY_JSON.
GREYBOX_DEFAULT_REGION=us
# off (default) for local/on-prem, audit for logging-only deployments, strict to
# reject managed inference requests that reach the wrong regional Cloud URL.
GREYBOX_DATA_RESIDENCY_ENFORCEMENT=off
# Regional Cloud URLs used by strict runtime enforcement and readiness reports.
# GREYBOX_REGION_US_BASE_URL=https://cloud-us.greybox.studio
# GREYBOX_REGION_EU_BASE_URL=https://cloud-eu.greybox.studio
# GREYBOX_REGION_IN_BASE_URL=https://cloud-in.greybox.studio

# ----- Audit log -------------------------------------------------------
# Directory path. In production this should live on a persistent volume
# (Render disk or Fly volume) and be backed up nightly.
GREYBOX_AUDIT_LOG_DIR=/data/audit-log
# When set, the audit log uses Postgres instead of the file-based JSONL store.
# Required for multi-replica enterprise deployments. Install `pg` as a peer
# dependency (npm install pg) when this is enabled.
# GREYBOX_AUDIT_LOG_PG_URL=postgres://greybox:****@db.internal:5432/greybox
# Optional: override the default `audit_log_entries` table name.
# GREYBOX_AUDIT_LOG_PG_TABLE=audit_log_entries
GREYBOX_AUDIT_SEAL_KEY_ID=prod-2026-q2
GREYBOX_AUDIT_SEAL_KEY=

# ----- SCIM ------------------------------------------------------------
GREYBOX_SCIM_TOKEN=
GREYBOX_SCIM_TENANT_ID=enterprise-scim
GREYBOX_SCIM_STORE_DIR=/data/scim
# When set, SCIM users persist to Postgres instead of the file-based store.
# Required for multi-replica / HA deployments. Install `pg` as a peer
# dependency (npm install pg) when this is enabled.
# GREYBOX_SCIM_PG_URL=postgres://greybox:****@db.internal:5432/greybox
# Optional: override the default `scim_users` table name.
# GREYBOX_SCIM_PG_TABLE=scim_users

# ----- Tenant store ----------------------------------------------------
# When populated, the TenantStore reloads tenants.json from this directory on boot.
GREYBOX_TENANT_STORE_DIR=/data/tenants
# When set, the TenantStore uses a Postgres-backed persister instead of the
# file-based default. Required for multi-replica / HA deployments. Install
# `pg` as a peer dependency (npm install pg) when this is enabled.
# GREYBOX_TENANT_STORE_PG_URL=postgres://greybox:****@db.internal:5432/greybox
# Optional: override the default `tenant_snapshot` table name.
# GREYBOX_TENANT_STORE_PG_TABLE=tenant_snapshot

# ----- Privacy rights requests ----------------------------------------
# Durable privacy-rights request intake and status ledger.
GREYBOX_PRIVACY_REQUEST_DIR=/data/privacy-requests
# Use Postgres instead of the file store for hosted multi-replica privacy ops.
# GREYBOX_PRIVACY_REQUEST_PG_URL=postgres://greybox:****@db.internal:5432/greybox
# Optional: override the default `privacy_requests` table name.
# GREYBOX_PRIVACY_REQUEST_PG_TABLE=privacy_requests

# ----- Model training consent -----------------------------------------
# Durable explicit opt-in records for future Greybox Native training.
GREYBOX_MODEL_TRAINING_CONSENT_DIR=/data/model-training-consent
# Use Postgres instead of the file store for hosted multi-replica enforcement.
# GREYBOX_MODEL_TRAINING_CONSENT_PG_URL=postgres://greybox:****@db.internal:5432/greybox
# Optional: override the default `model_training_consents` table name.
# GREYBOX_MODEL_TRAINING_CONSENT_PG_TABLE=model_training_consents

# ----- Security incidents ---------------------------------------------
# Durable incident-response ledger with GDPR breach clocks.
GREYBOX_SECURITY_INCIDENT_DIR=/data/security-incidents
# Use Postgres instead of the file store for hosted multi-replica evidence.
# GREYBOX_SECURITY_INCIDENT_PG_URL=postgres://greybox:****@db.internal:5432/greybox
# Optional: override the default `security_incidents` table name.
# GREYBOX_SECURITY_INCIDENT_PG_TABLE=security_incidents

# ----- Legal holds -----------------------------------------------------
# Durable legal-hold ledger for retention exceptions and deletion blockers.
GREYBOX_LEGAL_HOLD_DIR=/data/legal-holds
# Use Postgres instead of the file store for hosted multi-replica evidence.
# GREYBOX_LEGAL_HOLD_PG_URL=postgres://greybox:****@db.internal:5432/greybox
# Optional: override the default `legal_holds` table name.
# GREYBOX_LEGAL_HOLD_PG_TABLE=legal_holds
