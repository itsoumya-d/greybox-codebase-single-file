{
  "name": "@greybox-studio/cloud",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Closed-core Greybox managed inference, billing, auth, tenant, and observability service.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
