  "flow": [
    {
      "id": "flow-play",
      "from": "scr-main-menu",
      "to": "scr-gameplay",
      "trigger": { "type": "tap", "componentRef": "cmp-play" }
    },
    {
      "id": "flow-event",
      "from": "scr-gameplay",
      "to": "scr-main-menu",
      "trigger": { "type": "scriptEvent", "eventId": "door-open" }
    }
  ]
