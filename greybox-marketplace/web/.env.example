# Proprietary and confidential. Copyright (c) 2026 Greybox Studio.
# greybox-marketplace web app environment.
# Copy to .env.local and fill in values.

# URL of the marketplace API (no trailing slash).
# Default: http://127.0.0.1:8181 (matches greybox-marketplace/.env.example PORT)
MARKETPLACE_API_URL=http://127.0.0.1:8181

# Marketplace admin bearer token. Server-side only — never exposed to the
# browser. The Next.js proxy at /api/proxy injects it for non-public routes.
GREYBOX_MARKETPLACE_ADMIN_TOKEN=

# Port the web app listens on (Next.js).
WEB_PORT=38900
