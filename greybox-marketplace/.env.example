# greybox-marketplace environment configuration template.
# Copy to .env and fill in values. Never commit a populated .env file.

NODE_ENV=production
PORT=8181

# ----- Stripe Connect (production) --------------------------------------
# Required in production. The marketplace store refuses to instantiate
# without an explicit payoutProvider when NODE_ENV=production.
STRIPE_SECRET_KEY=

# Set to "1" to dry-run live Stripe API calls (no real transfer; useful for
# canary deploys). When STRIPE_SECRET_KEY is absent, dryRun defaults to true.
STRIPE_CONNECT_DRY_RUN=0

# Stripe API base. Override only for Stripe testmode mirrors.
STRIPE_API_BASE=https://api.stripe.com

# ----- Persistence ------------------------------------------------------
# JSONL audit log (append-only, hash-chained). Mount on persistent disk.
GREYBOX_MARKETPLACE_AUDIT_LOG_PATH=/data/marketplace-audit.jsonl

# File-backed snapshot of marketplace state (until Postgres migration).
GREYBOX_MARKETPLACE_SNAPSHOT_PATH=/data/marketplace-snapshot.json

# ----- Admin tokens -----------------------------------------------------
GREYBOX_MARKETPLACE_ADMIN_TOKEN=REPLACE_ME

# ----- Open-design daemon proxy companion env ---------------------------
# Set these on the open-design daemon, not on this marketplace service, when
# routing web purchases into hosted Stripe Checkout Sessions.
AGDS_MARKETPLACE_URL=https://marketplace.greybox.studio
AGDS_MARKETPLACE_TOKEN=REPLACE_ME
AGDS_MARKETPLACE_CHECKOUT_SUCCESS_URL=https://greybox.studio/marketplace/success?session_id={CHECKOUT_SESSION_ID}
AGDS_MARKETPLACE_CHECKOUT_CANCEL_URL=https://greybox.studio/marketplace/cancel

# ----- Cloud integration ------------------------------------------------
GREYBOX_CLOUD_URL=https://cloud.greybox.studio
GREYBOX_CLOUD_ADMIN_TOKEN=

# ----- Observability ---------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
