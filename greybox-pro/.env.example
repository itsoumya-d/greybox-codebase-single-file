# greybox-pro environment configuration template.
# Copy to .env when running the author-module / release-bundles CLIs.

# ----- Bundle signing (Ed25519) -----------------------------------------
# Path to the PKCS#8 PEM-encoded Ed25519 private key used to sign new bundles.
GREYBOX_PRO_PRIVATE_KEY_PATH=./.secrets/pro-signing-key.pem

# Bundle key id (for rotation). Increment when you rotate the signing key.
GREYBOX_PRO_SIGNING_KEY_ID=key-2026-05

# ----- Bundle encryption ------------------------------------------------
# Per-bundle license secret. Each customer purchase gets a unique secret;
# this env var is the master key the CLI derives per-bundle secrets from.
# Keep this in a secret store (1Password, AWS Secrets Manager).
GREYBOX_PRO_MODULE_SECRET_MASTER_KEY=REPLACE_ME

# ----- Distribution -----------------------------------------------------
# Cloudflare R2 (or any S3-compatible) bucket where signed bundles are
# uploaded. Used by the release-bundles CLI.
GREYBOX_PRO_BUNDLE_BUCKET=greybox-pro-bundles
GREYBOX_PRO_BUNDLE_REGION=auto
GREYBOX_PRO_BUNDLE_ENDPOINT=https://your-r2-account.r2.cloudflarestorage.com
GREYBOX_PRO_BUNDLE_ACCESS_KEY_ID=
GREYBOX_PRO_BUNDLE_SECRET_ACCESS_KEY=
