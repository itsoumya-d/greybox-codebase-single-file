{
  "name": "ai-game-design-studio",
  "version": "0.6.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "description": "Local-first AI game design studio: plans playable concepts, game systems, art bibles, HUDs, levels, trailers, audio, and production-ready game deliverables.",
  "license": "Apache-2.0",
  "bin": {
    "agds": "./apps/daemon/dist/cli.js"
  },
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs",
    "tools-dev": "pnpm exec tools-dev",
    "tools-pack": "pnpm exec tools-pack",
    "guard": "tsx ./scripts/guard.ts",
    "completion:audit": "tsx ./scripts/game-design-completion-audit.ts",
    "i18n:check": "tsx ./scripts/i18n-check.ts",
    "i18n:fallback-audit": "tsx ./scripts/i18n-fallback-audit.ts",
    "residual:language-audit": "tsx ./scripts/residual-language-audit.ts",
    "sync:community-pets": "node --experimental-strip-types scripts/sync-community-pets.ts",
    "bake:community-pets": "node --experimental-strip-types scripts/bake-community-pets.ts",
    "seed:test-projects": "node --experimental-strip-types scripts/seed-test-projects.ts",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck && tsc -p scripts/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "4.21.0",
    "typescript": "^5.6.3",
    "@ai-game-design-studio/tools-dev": "workspace:*",
    "@ai-game-design-studio/tools-pack": "workspace:*"
  },
  "engines": {
    "node": "~24",
    "pnpm": ">=10.33.2 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
